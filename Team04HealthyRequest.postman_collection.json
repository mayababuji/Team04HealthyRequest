              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{dieticianbaseBaseUrl}}/dietician/dietician",
              "host": [
                "{{dieticianbaseBaseUrl}}"
              ],
              "path": [
                "dietician",
