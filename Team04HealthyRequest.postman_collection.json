  "item": [
    {
      "name": "Admin",
      "item": [
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const requestType = pm.iterationData.get(\"requestType\");",
                  "console.log(\"Running scenario:\", pm.iterationData.get(\"scenario\"));",
                  "console.log(\"The request type in POST Admin Login is \"+ requestType)",
                  "if (requestType!=\"createAdmin\"){",
                  "    pm.execution.skipRequest();",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const scenario = pm.iterationData.get(\"scenario\");",
                  "",
                  "console.log(\"Running scenario:\", scenario);",
                  "console.log(\"Login status:\", pm.response.code);",
                  "console.log(\"Login response:\", pm.response.text());",
                  "",
                  "if (scenario === \"Valid Login\") {",
                  "    pm.test(\"Login should succeed\", function () {",
                  "        pm.response.to.have.status(200);",
                  "    });",
                  "",
                  "    if (pm.response.code === 200) {",
                  "        const response = pm.response.json();",
                  "        const adminToken = response.token;",
                  "",
                  "        pm.test(\"Login response contains token\", function () {",
                  "            pm.expect(response).to.have.property(\"token\");",
                  "            pm.expect(adminToken).to.be.a(\"string\").and.not.empty;",
                  "        });",
                  "",
                  "        pm.environment.set(\"admin_token\", adminToken);",
                  "",
                  "        console.log(\"Admin token was saved:\", Boolean(adminToken));",
                  "    }",
                  "",
                  "} else if (",
                  "    scenario === \"invalid login with incorrect username\" ||",
                  "    scenario === \"invalid login with empty username\" ||",
                  "    scenario === \"invalid login with incorrect password\" ||",
                  "    scenario === \"invalid login with empty UN and password\" ",
                  ") {",
                  "    pm.test(\"Login returns 401\", function () {",
                  "        pm.response.to.have.status(401);",
                  "    });",
                  "",
                  "    const responseBody = pm.response.text().trim();",
                  "",
                  "    if (responseBody === \"\") {",
                  "        pm.test(\"Empty-username login has an empty response body\", function () {",
                  "            pm.expect(responseBody).to.eql(\"\");",
                  "        });",
                  "",
                  "        console.log(\"401 received with an empty response body.\");",
                  "",
                  "    } else {",
                  "        const errorResponse = pm.response.json();",
                  "",
                  "        pm.test(\"Error response contains errorCode\", function () {",
                  "            pm.expect(errorResponse).to.have.property(\"errorCode\");",
                  "        });",
                  "",
                  "        pm.test(\"Error response contains errorMessage\", function () {",
                  "            pm.expect(errorResponse).to.have.property(\"errorMessage\");",
                  "        });",
                  "",
                  "        pm.test(\"Error code is correct\", function () {",
                  "            pm.expect(errorResponse.errorCode).to.eql(",
                  "                \"Invalid UserName or Password\"",
                  "            );",
                  "        });",
                  "",
                  "        pm.test(\"Error message is Bad credentials\", function () {",
                  "            pm.expect(errorResponse.errorMessage).to.eql(",
                  "                \"Bad credentials\"",
                  "            );",
                  "        });",
                  "    }",
                  "",
                  "} else {",
                  "    pm.test(\"Login scenario is recognized\", function () {",
                  "        pm.expect.fail(",
                  "            `Unknown login scenario: \"${scenario}\"`",
                  "        );",
                  "    });",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userLoginEmail\": \"{{userLoginEmail}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{dieticianbaseBaseUrl}}/dietician/login",
              "host": [
                "{{dieticianbaseBaseUrl}}"
              ],
              "path": [
                "dietician",
                "login"
              ]
            }
          },
          "response": []
        }
      ]
    },
