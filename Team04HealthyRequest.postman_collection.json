        {
          "name": "create new Patient",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const requestType = pm.iterationData.get(\"requestType\");",
                  "console.log(\"The request type in CREATE PATIENT  is \"+ requestType)",
                  "if (requestType !== \"createPatient\") {",
                  "    console.log(\"Skipping this iteration as requestType is not createPatient\");",
                  "    ",
                  "     pm.execution.skipRequest();",
                  "} else {",
                  "    // Build patientInfo JSON dynamically",
                  "    let patientInfo = {",
                  "        \"FirstName\": pm.iterationData.get(\"Firstname\"),",
                  "        \"LastName\": pm.iterationData.get(\"Lastname\"),",
                  "        \"ContactNumber\": pm.iterationData.get(\"ContactNumber\"),",
                  "        \"Email\": pm.iterationData.get(\"Email\"),",
                  "        \"Allergy\": pm.iterationData.get(\"Allergy\"),",
                  "        \"FoodPreference\": pm.iterationData.get(\"FoodPreference\"),",
                  "        \"CuisineCategory\": pm.iterationData.get(\"CuisineCategory\"),",
                  "        \"DateOfBirth\": pm.iterationData.get(\"DateOfBirth\")",
                  "    };",
                  "    console.log(\"patientinfo is \"+patientInfo)",
                  "    pm.collectionVariables.set(\"patientInfo\", JSON.stringify(patientInfo));",
                  "    let vitals = {",
                  "        \"Weight\": pm.iterationData.get(\"Weight\"),",
                  "        \"Height\": pm.iterationData.get(\"Height\"),",
                  "        \"Temperature\": pm.iterationData.get(\"Temperature\"),",
                  "        \"SP\": pm.iterationData.get(\"SP\"),",
                  "        \"DP\": pm.iterationData.get(\"DP\")",
                  "    };",
                  "    console.log(\"vitals is \" + vitals)",
                  "    pm.collectionVariables.set(\"vitals\", JSON.stringify(vitals));",
                  "}",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const scenario = pm.iterationData.get(\"scenario\");",
                  "",
                  "console.log(\"Running scenario:\", scenario);",
                  "console.log(\"Create Patient response status:\", pm.response.code);",
                  "console.log(\"Create Patient response body:\", pm.response.text());",
                  "",
                  "// =====================================================",
                  "// VALID PATIENT SCENARIO",
                  "// CSV value must be exactly: Valid Patient",
                  "// =====================================================",
                  "",
                  "if (scenario === \"Valid Patient\") {",
                  "",
                  "    pm.test(\"Create Patient returns 201\", function () {",
                  "        pm.response.to.have.status(201);",
                  "    });",
                  "",
                  "    pm.test(\"Response Content-Type is JSON\", function () {",
                  "        pm.expect(pm.response.headers.get(\"Content-Type\"))",
                  "            .to.include(\"application/json\");",
                  "    });",
                  "",
                  "    if (pm.response.code === 201) {",
                  "        const response = pm.response.json();",
                  "",
                  "        console.log(",
                  "            \"Create Patient response:\",",
                  "            JSON.stringify(response, null, 2)",
                  "        );",
                  "",
                  "        // ---------- JSON Schema ----------",
                  "",
                  "        const patientSchema = {",
                  "            type: \"object\",",
                  "            required: [",
                  "                \"patientId\",",
                  "                \"FirstName\",",
                  "                \"LastName\",",
                  "                \"ContactNumber\",",
                  "                \"Email\",",
                  "                \"Allergy\",",
                  "                \"FoodPreference\",",
                  "                \"CuisineCategory\",",
                  "                \"DateOfBirth\",",
                  "                \"DieticianId\",",
                  "                \"Vitals\",",
                  "                \"LastVisitDate\"",
                  "            ],",
                  "            properties: {",
                  "                patientId: {",
                  "                    type: \"integer\",",
                  "                    minimum: 1",
                  "                },",
                  "                FirstName: {",
                  "                    type: \"string\",",
                  "                    minLength: 1",
                  "                },",
                  "                LastName: {",
                  "                    type: \"string\",",
                  "                    minLength: 1",
                  "                },",
                  "                ContactNumber: {",
                  "                    type: \"string\",",
                  "                    pattern: \"^[0-9]{10}$\"",
                  "                },",
                  "                Email: {",
                  "                    type: \"string\",",
                  "                    format: \"email\"",
                  "                },",
                  "                Allergy: {",
                  "                    type: \"string\",",
                  "                    minLength: 1",
                  "                },",
                  "                FoodPreference: {",
                  "                    type: \"string\",",
                  "                    minLength: 1",
                  "                },",
                  "                CuisineCategory: {",
                  "                    type: \"string\",",
                  "                    minLength: 1",
                  "                },",
                  "                DateOfBirth: {",
                  "                    type: \"string\",",
                  "                    pattern: \"^\\\\d{4}-\\\\d{2}-\\\\d{2}$\"",
                  "                },",
                  "                DieticianId: {",
                  "                    type: \"integer\",",
                  "                    minimum: 1",
                  "                },",
                  "                Vitals: {",
                  "                    type: \"object\",",
                  "                    minProperties: 1,",
                  "                    additionalProperties: {",
                  "                        type: \"object\",",
                  "                        required: [",
                  "                            \"Weight\",",
                  "                            \"Height\",",
                  "                            \"Temperature\",",
                  "                            \"SP\",",
                  "                            \"DP\"",
                  "                        ],",
                  "                        properties: {",
                  "                            Weight: {",
                  "                                type: \"number\",",
                  "                                minimum: 0",
                  "                            },",
                  "                            Height: {",
                  "                                type: \"number\",",
                  "                                minimum: 0",
                  "                            },",
                  "                            Temperature: {",
                  "                                type: \"number\"",
                  "                            },",
                  "                            SP: {",
                  "                                type: \"number\",",
                  "                                minimum: 0",
                  "                            },",
                  "                            DP: {",
                  "                                type: \"number\",",
                  "                                minimum: 0",
                  "                            }",
                  "                        }",
                  "                    }",
                  "                },",
                  "                LastVisitDate: {",
                  "                    type: \"string\",",
                  "                    format: \"date-time\"",
                  "                }",
                  "            }",
                  "        };",
                  "",
                  "        pm.test(\"Create Patient response matches JSON schema\", function () {",
                  "            pm.response.to.have.jsonSchema(patientSchema);",
                  "        });",
                  "",
                  "        // ---------- Patient ID ----------",
                  "",
                  "        pm.test(\"Patient ID is returned\", function () {",
                  "            pm.expect(response.patientId).to.exist;",
                  "            pm.expect(response.patientId).to.be.a(\"number\");",
                  "            pm.expect(response.patientId).to.be.greaterThan(0);",
                  "        });",
                  "",
                  "        pm.collectionVariables.set(",
                  "            \"patientId\",",
                  "            String(response.patientId)",
                  "        );",
                  "",
                  "        console.log(\"Saved patientId:\", response.patientId);",
                  "",
                  "        // ---------- Patient fields ----------",
                  "",
                  "        pm.test(\"Patient details are returned\", function () {",
                  "            pm.expect(response).to.have.property(\"FirstName\");",
                  "            pm.expect(response).to.have.property(\"LastName\");",
                  "            pm.expect(response).to.have.property(\"ContactNumber\");",
                  "            pm.expect(response).to.have.property(\"Email\");",
                  "            pm.expect(response).to.have.property(\"Allergy\");",
                  "            pm.expect(response).to.have.property(\"FoodPreference\");",
                  "            pm.expect(response).to.have.property(\"CuisineCategory\");",
                  "            pm.expect(response).to.have.property(\"DateOfBirth\");",
                  "            pm.expect(response).to.have.property(\"DieticianId\");",
                  "            pm.expect(response).to.have.property(\"Vitals\");",
                  "            pm.expect(response).to.have.property(\"LastVisitDate\");",
                  "        });",
                  "",
                  "        pm.test(\"Patient details match CSV test data\", function () {",
                  "            pm.expect(response.FirstName).to.eql(",
                  "                pm.iterationData.get(\"Firstname\")",
                  "            );",
                  "",
                  "            pm.expect(response.LastName).to.eql(",
                  "                pm.iterationData.get(\"Lastname\")",
                  "            );",
                  "",
                  "            pm.expect(String(response.ContactNumber)).to.eql(",
                  "                String(pm.iterationData.get(\"ContactNumber\"))",
                  "            );",
                  "",
                  "            pm.expect(response.Email).to.eql(",
                  "                pm.iterationData.get(\"Email\")",
                  "            );",
                  "",
                  "            pm.expect(response.Allergy).to.eql(",
                  "                pm.iterationData.get(\"Allergy\")",
                  "            );",
                  "",
                  "            pm.expect(response.FoodPreference).to.eql(",
                  "                pm.iterationData.get(\"FoodPreference\")",
                  "            );",
                  "",
                  "            pm.expect(response.CuisineCategory).to.eql(",
                  "                pm.iterationData.get(\"CuisineCategory\")",
                  "            );",
                  "",
                  "            pm.expect(response.DateOfBirth).to.eql(",
                  "                pm.iterationData.get(\"DateOfBirth\")",
                  "            );",
                  "        });",
                  "",
                  "        // ---------- Patient-dietician relationship ----------",
                  "",
                  "        const expectedDieticianId =",
                  "            pm.collectionVariables.get(\"dieticianID\");",
                  "",
                  "        pm.test(\"Patient belongs to the created dietician\", function () {",
                  "            pm.expect(",
                  "                expectedDieticianId,",
                  "                \"dieticianID collection variable should exist\"",
                  "            ).to.exist;",
                  "",
                  "            pm.expect(String(response.DieticianId)).to.eql(",
                  "                String(expectedDieticianId)",
                  "            );",
                  "        });",
                  "",
                  "        // ---------- Dynamic Vitals IDs ----------",
                  "",
                  "        const vitalsObject = response.Vitals;",
                  "        const vitalIds = Object.keys(vitalsObject);",
                  "",
                  "        pm.test(\"At least one vital record is returned\", function () {",
                  "            pm.expect(vitalsObject).to.be.an(\"object\");",
                  "            pm.expect(vitalIds).to.not.be.empty;",
                  "        });",
                  "",
                  "        const firstVitalId = vitalIds[0];",
                  "        const vital = vitalsObject[firstVitalId];",
                  "",
                  "        pm.collectionVariables.set(",
                  "            \"vitalIds\",",
                  "            JSON.stringify(vitalIds)",
                  "        );",
                  "",
                  "        pm.collectionVariables.set(",
                  "            \"firstVitalId\",",
                  "            firstVitalId",
                  "        );",
                  "",
                  "        console.log(\"Saved vital IDs:\", vitalIds);",
                  "        console.log(\"Saved firstVitalId:\", firstVitalId);",
                  "        console.log(\"Vital values:\", JSON.stringify(vital, null, 2));",
                  "",
                  "        // ---------- Vital values ----------",
                  "",
                  "        pm.test(\"Vital measurements are returned\", function () {",
                  "            pm.expect(vital).to.have.property(\"Weight\");",
                  "            pm.expect(vital).to.have.property(\"Height\");",
                  "            pm.expect(vital).to.have.property(\"Temperature\");",
                  "            pm.expect(vital).to.have.property(\"SP\");",
                  "            pm.expect(vital).to.have.property(\"DP\");",
                  "        });",
                  "",
                  "        pm.test(\"Vital measurements match CSV test data\", function () {",
                  "            pm.expect(vital.Weight).to.eql(",
                  "                Number(pm.iterationData.get(\"Weight\"))",
                  "            );",
                  "",
                  "            pm.expect(vital.Height).to.eql(",
                  "                Number(pm.iterationData.get(\"Height\"))",
                  "            );",
                  "",
                  "            pm.expect(vital.Temperature).to.eql(",
                  "                Number(pm.iterationData.get(\"Temperature\"))",
                  "            );",
                  "",
                  "            pm.expect(vital.SP).to.eql(",
                  "                Number(pm.iterationData.get(\"SP\"))",
                  "            );",
                  "",
                  "            pm.expect(vital.DP).to.eql(",
                  "                Number(pm.iterationData.get(\"DP\"))",
                  "            );",
                  "        });",
                  "",
                  "        // ---------- Date validation ----------",
                  "",
                  "        pm.test(\"LastVisitDate is a valid date-time\", function () {",
                  "            const lastVisitDate = new Date(response.LastVisitDate);",
                  "",
                  "            pm.expect(lastVisitDate.toString())",
                  "                .to.not.eql(\"Invalid Date\");",
                  "        });",
                  "    }",
                  "",
                  "// =====================================================",
                  "// INVALID: BLANK PATIENT FIRST NAME",
                  "// CSV value must be exactly: Blank patient first name",
                  "// =====================================================",
                  "",
                  "} else if (scenario === \"Blank patient first name\") {",
                  "",
                  "    pm.test(\"Create Patient returns 400 for blank first name\", function () {",
                  "        pm.response.to.have.status(400);",
                  "    });",
                  "",
                  "    pm.test(\"Error response Content-Type is JSON\", function () {",
                  "        pm.expect(pm.response.headers.get(\"Content-Type\"))",
                  "            .to.include(\"application/json\");",
                  "    });",
                  "",
                  "    if (pm.response.code === 400) {",
                  "        const errorResponse = pm.response.json();",
                  "",
                  "        console.log(",
                  "            \"Blank patient first name error response:\",",
                  "            JSON.stringify(errorResponse, null, 2)",
                  "        );",
                  "",
                  "        const errorSchema = {",
                  "            type: \"object\",",
                  "            required: [",
                  "                \"errorCode\",",
                  "                \"errorMessage\"",
                  "            ],",
                  "            properties: {",
                  "                errorCode: {",
                  "                    type: \"string\",",
                  "                    minLength: 1",
                  "                },",
                  "                errorMessage: {",
                  "                    type: \"string\",",
