        {
          "name": "create new Patient",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "exec": [
                  "const requestType = pm.iterationData.get(\"requestType\");",
                  "console.log(\"The request type in CREATE PATIENT  is \"+ requestType)",
                  "if (requestType !== \"createPatient\") {",
                  "    console.log(\"Skipping this iteration as requestType is not createPatient\");",
                  "    ",
                  "     pm.execution.skipRequest();",
                  "} else {",
                  "    // Build patientInfo JSON dynamically",
                  "    let patientInfo = {",
                  "        \"FirstName\": pm.iterationData.get(\"Firstname\"),",
                  "        \"LastName\": pm.iterationData.get(\"Lastname\"),",
                  "        \"ContactNumber\": pm.iterationData.get(\"ContactNumber\"),",
                  "        \"Email\": pm.iterationData.get(\"Email\"),",
                  "        \"Allergy\": pm.iterationData.get(\"Allergy\"),",
                  "        \"FoodPreference\": pm.iterationData.get(\"FoodPreference\"),",
                  "        \"CuisineCategory\": pm.iterationData.get(\"CuisineCategory\"),",
                  "        \"DateOfBirth\": pm.iterationData.get(\"DateOfBirth\")",
                  "    };",
                  "    console.log(\"patientinfo is \"+patientInfo)",
                  "    pm.collectionVariables.set(\"patientInfo\", JSON.stringify(patientInfo));",
                  "    let vitals = {",
                  "        \"Weight\": pm.iterationData.get(\"Weight\"),",
                  "        \"Height\": pm.iterationData.get(\"Height\"),",
                  "        \"Temperature\": pm.iterationData.get(\"Temperature\"),",
                  "        \"SP\": pm.iterationData.get(\"SP\"),",
                  "        \"DP\": pm.iterationData.get(\"DP\")",
                  "    };",
                  "    console.log(\"vitals is \" + vitals)",
                  "    pm.collectionVariables.set(\"vitals\", JSON.stringify(vitals));",
                  "}",
                  ""
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            },
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Create Patient returns 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "",
                  "if (pm.response.code === 201) {",
                  "    const response = pm.response.json();",
                  "",
                  "    console.log(\"Patient response:\", JSON.stringify(response, null, 2));",
                  "",
                  "    // Validate and save patient ID",
                  "    pm.test(\"Patient ID is returned\", function () {",
                  "        pm.expect(response.patientId).to.exist;",
                  "    });",
                  "",
                  "    pm.collectionVariables.set(\"patientId\", String(response.patientId));",
                  "",
                  "    // Validate core patient fields",
                  "    pm.test(\"Patient details are returned\", function () {",
                  "        pm.expect(response).to.have.property(\"FirstName\");",
                  "        pm.expect(response).to.have.property(\"LastName\");",
                  "        pm.expect(response).to.have.property(\"Email\");",
                  "        pm.expect(response).to.have.property(\"DieticianId\");",
                  "        pm.expect(response).to.have.property(\"Vitals\");",
                  "    });",
                  "",
                  "    // Compare returned patient data with CSV iteration data",
                  "    pm.test(\"Patient first name matches test data\", function () {",
                  "        pm.expect(response.FirstName).to.eql(",
                  "            pm.iterationData.get(\"Firstname\")",
                  "        );",
                  "    });",
                  "",
                  "    pm.test(\"Patient last name matches test data\", function () {",
                  "        pm.expect(response.LastName).to.eql(",
                  "            pm.iterationData.get(\"Lastname\")",
                  "        );",
                  "    });",
                  "",
                  "    pm.test(\"Patient email matches test data\", function () {",
                  "        pm.expect(response.Email).to.eql(",
                  "            pm.iterationData.get(\"Email\")",
                  "        );",
                  "    });",
                  "",
                  "    // Vitals is an object with a generated/dynamic ID as its key",
                  "    const vitalsObject = response.Vitals;",
                  "",
                  "    pm.test(\"Vitals are returned\", function () {",
                  "        pm.expect(vitalsObject).to.be.an(\"object\");",
                  "        pm.expect(vitalsObject).to.not.be.empty;",
                  "    });",
                  "",
                  "    const vitalIds = Object.keys(vitalsObject);",
                  "    const firstVitalId = vitalIds[0];",
                  "    const vital = vitalsObject[firstVitalId];",
                  "",
                  "",
                  "    console.log(\"Patient ID:\", response.patientId);",
                  "    console.log(\"Vital record ID:\", firstVitalId);",
                  "    console.log(\"Vital values:\", JSON.stringify(vital, null, 2));",
                  "",
                  "    // Validate returned vitals",
                  "    pm.test(\"Vital measurements are returned\", function () {",
                  "        pm.expect(vital).to.have.property(\"Weight\");",
                  "        pm.expect(vital).to.have.property(\"Height\");",
                  "        pm.expect(vital).to.have.property(\"Temperature\");",
                  "        pm.expect(vital).to.have.property(\"SP\");",
                  "        pm.expect(vital).to.have.property(\"DP\");",
                  "    });",
                  "",
                  "    // Compare values after converting CSV strings to numbers",
                  "    pm.test(\"Weight matches test data\", function () {",
                  "        pm.expect(vital.Weight).to.eql(",
                  "            Number(pm.iterationData.get(\"Weight\"))",
                  "        );",
                  "    });",
                  "",
                  "    pm.test(\"Height matches test data\", function () {",
                  "        pm.expect(vital.Height).to.eql(",
                  "            Number(pm.iterationData.get(\"Height\"))",
                  "        );",
                  "    });",
                  "",
                  "    pm.test(\"Temperature matches test data\", function () {",
                  "        pm.expect(vital.Temperature).to.eql(",
                  "            Number(pm.iterationData.get(\"Temperature\"))",
                  "        );",
                  "    });",
                  "",
                  "    pm.test(\"Systolic pressure matches test data\", function () {",
                  "        pm.expect(vital.SP).to.eql(",
                  "            Number(pm.iterationData.get(\"SP\"))",
                  "        );",
                  "    });",
                  "",
                  "    pm.test(\"Diastolic pressure matches test data\", function () {",
                  "        pm.expect(vital.DP).to.eql(",
                  "            Number(pm.iterationData.get(\"DP\"))",
                  "        );",
                  "    });",
                  "}"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
